# Keep this file secret if populated. Do not commit your real .env.
QWEN_API_KEY=
# Use the endpoint shown in your Qwen / Model Studio account.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# MongoDB Atlas configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/
MONGODB_DATABASE=futuremind_ai

# Server & CORS configuration
PORT=8000
# Deployed frontend URL (e.g. https://your-project.vercel.app or comma-separated)
FRONTEND_URL=http://localhost:5173
